# Godot 4
.godot/
/android/

# Every dot-* addon is a separate repository. For local development, symlink them:
#   ln -s ../../dot-core/addons/dot_core addons/dot_core
# A shipped build copies them in instead.
#
# THIS LIST IS ALSO THE DEPENDENCY MANIFEST. dot-bootstrap derives what to link from
# these lines rather than keeping a second copy, because the repository that gains a
# dependency is the repository that has to ignore its link.
/addons/dot_core
/addons/dot_vehicle

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Screenshots are evidence for a review, not assets.
/screenshots/

# Editors
.vscode/
